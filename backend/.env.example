# Server Configuration
PORT=5000
NODE_ENV=development

# AI Service Configuration (Optional)
# Uncomment and configure to enable AI-powered responses
# AI_API_KEY=your-api-key-here
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-3.5-turbo

# Email Service Configuration - SMTP (Gmail)
# IMPORTANT: Use Gmail App Password, NOT your regular Gmail password!
# To generate Gmail App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification (required)
# 3. Go to App passwords → Select "Mail" and "Windows Computer"
# 4. Copy the 16-character password (no spaces) and paste as SMTP_PASS

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
RECIPIENT_EMAIL=kishorhcs@gmail.com

# CORS Configuration
# CORS_ORIGIN=http://localhost:3000
